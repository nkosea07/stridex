{
  "$schema": "https://opencode.ai/config.json",

  "providers": {
    "deepseek": {
      "name": "DeepSeek",
      "env": ["DEEPSEEK_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible/responses",
      "settings": {
        "baseURL": "https://api.deepseek.com/"
      },
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek Flash"
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro"
        }
      }
    }
  }
}
