# Copy to a protected deployment environment; replace every CHANGE_ME value.
# Do not commit a populated environment file.
DB_HOST=db
DB_PORT=5432
DB_NAME=race_tracker
DB_USERNAME=race_admin
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
JWT_SECRET=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Must be the public HTTPS origin, without a trailing slash.
FRONTEND_URL=https://race.example.com
WEB_HOST_PORT=8080
# Include exact ingress proxy IPs only; the Compose web proxy is 172.29.42.10.
TRUSTED_PROXIES=172.29.42.10

# Private media storage. Production must select aws-s3 or minio; local storage is
# development-only. The Kubernetes pilot bootstrap expects static AWS credentials;
# replace both CHANGE_ME values in the protected secret file.
STORAGE_PROVIDER=aws-s3
AWS_S3_ENABLED=true
AWS_S3_BUCKET=CHANGE_ME_MEDIA_BUCKET
AWS_S3_REGION=us-east-1
AWS_S3_ENDPOINT=
AWS_S3_ACCESS_KEY=CHANGE_ME_AWS_ACCESS_KEY
AWS_S3_SECRET_KEY=CHANGE_ME_AWS_SECRET_KEY
AWS_S3_PATH_STYLE_ACCESS=false
MINIO_ENABLED=false
MINIO_BUCKET=
MINIO_REGION=us-east-1
MINIO_ENDPOINT=https://minio.example.com
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_PATH_STYLE_ACCESS=true

# Production requires MAIL_ENABLED=true with a verified relay; staging may use false.
MAIL_ENABLED=false
MAIL_HOST=CHANGE_ME_SMTP_HOST
MAIL_PORT=587
MAIL_FROM=CHANGE_ME_FROM_ADDRESS
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional RFID gateway (compose profile "rfid"). The pilot backend runs the prod
# profile with RFID_SIMULATION_ENABLED=false, so it rejects SIMULATED reads; the
# gateway must run in hardware mode with real reader metadata. Simulation mode is
# only for a local development backend. Do not enable this profile before physical
# reader acceptance.
RFID_BACKEND_READER_KEY=CHANGE_ME_READER_INGEST_KEY
RFID_GATEWAY_MODE=hardware
RFID_GATEWAY_NAME=pilot-edge
RFID_GATEWAY_HARDWARE_MODEL=CHANGE_ME_READER_MODEL
RFID_GATEWAY_HARDWARE_PROFILE=IMPINJ_EVENT_GRADE
RFID_GATEWAY_READER_CLASS=FIXED_4_PORT
RFID_GATEWAY_READER_SERIAL=CHANGE_ME_READER_SERIAL
RFID_GATEWAY_HOST_PORT=8090

# Optional push notifications (Firebase Cloud Messaging). Requires a service account JSON.
PUSH_ENABLED=false
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=

# Optional results payments via Pesepay (covers EcoCash, cards, Zimswitch).
PAYMENTS_ENABLED=false
PESEPAY_BASE_URL=https://api.pesepay.com/api/payments-engine/v1
PESEPAY_INTEGRATION_KEY=
PESEPAY_ENCRYPTION_KEY=
# Required when PAYMENTS_ENABLED=true; checkout is refused while these are blank.
PAYMENTS_RESULT_URL=
PAYMENTS_RETURN_URL=
PAYMENTS_CURRENCY=USD

# Messaging: WhatsApp via Meta Cloud API. SMS is disabled in this release.
SMS_ENABLED=false
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_DEFAULT_TEMPLATE=race_update
WHATSAPP_LANGUAGE_CODE=en_US
