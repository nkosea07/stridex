{
  "apiVersion": 1,
  "apiPath": "/api",
  "web": {
    "apiBasePath": "/api/v1",
    "wsTrackingPath": "/api/ws/tracking"
  },
  "mobile": {
    "defaultApiRoot": "http://localhost:8081/api"
  },
  "endpoints": {
    "authLogin": "/auth/login",
    "authRegister": "/auth/register",
    "authRegisterOrganizer": "/auth/register-organizer",
    "authRefresh": "/auth/refresh",
    "authMe": "/auth/me",
    "authProfile": "/auth/profile",
    "racesList": "/races",
    "raceById": "/races/:id",
    "raceRegister": "/races/:id/participants/register",
    "publicRaceHub": "/public/races/:raceId/hub",
    "publicRaceLive": "/public/races/:raceId/tracking/live",
    "publicRaceLiveFeed": "/public/races/:raceId/tracking/live-feed",
    "publicRaceResults": "/public/races/:raceId/results",
    "publicRaceSearch": "/public/races/:raceId/tracking/search",
    "publicAthleteTracking": "/public/races/:raceId/tracking/athletes/:participantId",
